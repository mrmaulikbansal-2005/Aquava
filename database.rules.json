{
  "rules": {
    "sessions": {
      "$session": {
        ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL' && auth.token.email_verified === true",
        "players": {
          ".read": "auth != null",
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "scans": {
          ".read": "auth != null",
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "groups": {
          ".read": "auth != null",
          "$code": { ".write": "auth != null" }
        },
        "posts": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
            "cheers": { "$uid": { ".write": "auth != null && auth.uid === $uid" } }
          }
        },
        "contacts": {
          ".read": "auth != null && auth.token.email === 'ADMIN_EMAIL' && auth.token.email_verified === true",
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        }
      }
    }
  }
}
